{
  "name": "motion-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs --dev",
    "build": "vite build",
    "build:static": "vite build --mode static",
    "preview:static": "vite preview --mode static --host 127.0.0.1",
    "preview": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "cloudflare:dev": "wrangler dev --ip 127.0.0.1 --port 8787 --var APP_ORIGIN:http://localhost:8787",
    "cloudflare:check": "node scripts/check-cloudflare.mjs",
    "deploy": "npm test && npm run build && wrangler deploy",
    "postinstall": "node scripts/copy-licenses.mjs",
    "curriculum:import": "node scripts/build-curriculum.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "canvas-confetti": "1.9.4",
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.13"
  },
  "devDependencies": {
    "vite": "8.1.1",
    "wrangler": "4.147.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
